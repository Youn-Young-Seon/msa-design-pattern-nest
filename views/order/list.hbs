<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>주문 내역</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container py-4">
    <nav class="navbar navbar-expand navbar-dark bg-dark rounded mb-4">
        <div class="navbar-nav">
            <a class="nav-link" href="/products">전체 상품</a>
            <a class="nav-link" href="/cart">장바구니</a>
            <a class="nav-link" href="/orders">주문내역</a>
        </div>
    </nav>

    <h2>주문 내역</h2>

    <div class="accordion" id="ordersAccordion">
        {{#if orders.length}}
        <div class="accordion-item">
            {{#each orders}}
            <h2 class="accordion-header" id="heading {{this.id}}">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapse{{this.id}}">
                    주문 번호: <span>{{this.id}}</span>&nbsp;|&nbsp;
                    일시: <span>{{this.orderDate}}</span>&nbsp;|&nbsp;
                    총액: <span>{{this.totalAmount}} 원</span>
                </button>
            </h2>
            <div id="collapse {{this.id}}" class="accordion-collapse collapse"
                 aria-labelledby="heading {{this.id}}" data-bs-parent="#ordersAccordion">
                <div class="accordion-body">
                    <ul class="list-group">
                        {{#each items}}
                        <li class="list-group-item">
                            {{this.product.name}} x {{this.quantity}} 개 = {{this.totalAmount}} 원
                        </li>
                        {{/each}}
                    </ul>
                </div>
            </div>
            {{/each}}
        </div>
        {{/if}}
        {{#unless orders.length}}
        <div class="alert alert-info mt-3">
            아직 주문이 없습니다.
        </div>
        {{/unless}}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>