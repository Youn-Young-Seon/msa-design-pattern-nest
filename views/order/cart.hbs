<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>장바구니</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>
    <div class="container py-4">
        <nav class="navbar navbar-expand navbar-dark bg-dark rounded mb-4">
            <div class="navbar-nav">
                <a class="nav-link" href="/products">전체 상품</a>
                <a class="nav-link" href="/cart">장바구니</a>
                <a class="nav-link" href="/orders">주문내역</a>
            </div>
        </nav>

        <h2>장바구니</h2>

        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>상품명</th>
                    <th>수량</th>
                    <th>가격(단가)</th>
                </tr>
            </thead>
            <tbody>
                {{#if items.length}}
                    {{#each items}}
                    <tr>
                        <td>{{ this.product.name }}</td>
                        <td>{{ this.quantity }}</td>
                        <td>{{ this.price }} 원</td>
                    </tr>
                    {{/each}}
                {{/if}}
                {{#unless items.length}}
                    <td colspan="3" class="text-center">장바구니가 비어 있습니다.</td>
                {{/unless }}
            </tbody>
        </table>

        <div class="mt-3">
            {{#if items.length}}
            <a class="btn btn-primary" href="/order/checkout">주문하기</a>
            {{/if}}
        </div>

        {{#if errorMessage}}
        <div class="alert alert-danger mt-3">{{errorMessage}}</div>
        {{/if}}
    </div>
</body>

</html>